{
  "name": "@justeattakeaway/pie-dropdown",
  "description": "PIE Design System Dropdown built using Web Components",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/justeattakeaway/pie",
    "directory": "packages/components/pie-dropdown"
  },
  "homepage": "https://webc.pie.design/?path=/docs/components-dropdown--overview",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "custom-elements.json",
    "src",
    "dist",
    "**/*.d.ts"
  ],
  "pieMetadata": {
    "componentStatus": "alpha"
  },
  "scripts": {
    "build": "run -T vite build",
    "build:react-wrapper": "run -T build-react-wrapper",
    "create:manifest": "run -T cem analyze --litelement",
    "lint:scripts": "run -T eslint .",
    "lint:scripts:fix": "yarn lint:scripts --fix",
    "lint:style": "run -T stylelint ./src/**/*.{css,scss}",
    "lint:style:fix": "yarn lint:style --fix",
    "watch": "run -T vite build --watch",
    "test:browsers": "run -T playwright test -c ./playwright-lit.config.ts",
    "test:browsers:ci": "yarn test:browsers",
    "test:visual": "run -T cross-env-shell PERCY_TOKEN=${PERCY_TOKEN_PIE_DROPDOWN} percy exec --allowed-hostname cloudfront.net -- run -T playwright test -c ./playwright-lit-visual.config.ts",
    "test:visual:ci": "yarn test:visual"
  },
  "author": "Just Eat Takeaway.com - Design System Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@justeattakeaway/pie-components-config": "0.21.5",
    "@justeattakeaway/pie-css": "1.9.1",
    "@justeattakeaway/pie-monorepo-utils": "0.9.12"
  },
  "dependencies": {
    "@justeattakeaway/pie-assistive-text": "1.0.16",
    "@justeattakeaway/pie-checkbox": "1.4.10",
    "@justeattakeaway/pie-checkbox-group": "1.2.12",
    "@justeattakeaway/pie-chip": "1.0.17",
    "@justeattakeaway/pie-form-label": "1.0.1",
    "@justeattakeaway/pie-icons-webc": "1.29.5",
    "@justeattakeaway/pie-list": "0.8.1",
    "@justeattakeaway/pie-spinner": "1.5.11",
    "@justeattakeaway/pie-webc-core": "22.0.1",
    "element-internals-polyfill": "3.0.2"
  },
  "customElements": "custom-elements.json",
  "sideEffects": [
    "dist/*.js"
  ]
}
