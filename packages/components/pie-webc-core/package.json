{
  "name": "@justeattakeaway/pie-webc-core",
  "version": "22.0.1",
  "description": "PIE design system base classes, mixins and utilities for web components",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "src/internals/PieElement": [
        "dist/internals.d.ts"
      ],
      "src/internals/PieElement.js": [
        "dist/internals.d.ts"
      ]
    }
  },
  "author": "Just Eat Takeaway.com - Design System Team",
  "license": "Apache-2.0",
  "files": [
    "src/context",
    "src/decorators",
    "src/functions",
    "src/interfaces",
    "src/mixins",
    "src/types",
    "src/index.ts",
    "index.ts",
    "dist",
    "**/*.d.ts"
  ],
  "scripts": {
    "build": "run -T vite build",
    "lint:scripts": "run -T eslint .",
    "lint:scripts:fix": "run -T eslint . --fix",
    "watch": "run -T vite build --watch",
    "test": "run -T vitest run --config ../../../vite.config.js",
    "test:ci": "yarn test",
    "test:browsers": "run -T playwright test -c ./playwright-lit.config.ts",
    "test:browsers:ci": "yarn test:browsers",
    "test:watch": "run -T vitest"
  },
  "dependencies": {
    "@lit/context": "1.1.6",
    "lit": "3.3.3"
  },
  "peerDependencies": {
    "@justeattakeaway/pie-css": "1.x"
  },
  "devDependencies": {
    "@justeattakeaway/pie-components-config": "0.21.5",
    "@justeattakeaway/pie-monorepo-utils": "0.9.12"
  }
}
